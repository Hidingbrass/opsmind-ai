# 默认模式无需 API Key，适合离线演示和确定性回归。
OPSMIND_DIAGNOSIS_MODE=deterministic

# 切换为 llm 后填写 OpenAI-compatible /chat/completions 服务。
OPSMIND_LLM_PROVIDER=openai-compatible
OPSMIND_LLM_BASE_URL=https://api.example.com/v1
OPSMIND_LLM_API_KEY=
OPSMIND_LLM_MODEL=
OPSMIND_LLM_PROMPT_VERSION=opsmind-agent-v1
OPSMIND_LLM_MAX_STEPS=6
OPSMIND_LLM_TIMEOUT_SECONDS=45
OPSMIND_LLM_FALLBACK_ENABLED=true
